# ===================================================================
# 新路由3 / Newifi D2 (d-team_newifi-d2) 定制配置
# 基线: ImmortalWrt openwrt-21.02  (内核 5.4 / iptables)
# 设计目标: 硬件 NAT 直通 + 主机游戏加速器运行环境 + 轻量运维
# 注: 这是一份 seed config，make defconfig 会自动补全其余选项
# ===================================================================

# ---------- 目标设备 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# ---------- 固件格式 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=n
CONFIG_TARGET_ROOTFS_EXT4FS=n

# ---------- 基础系统 ----------
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-compat=y

# ---------- 界面汉化 ----------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ---------- 游戏加速器运行环境（UU / 奇游 共用） ----------
# UPnP 是手机 App 发现路由插件的通道，缺了它 App 连不上
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_libpcap=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-netem=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_tc-tiny=n
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_ip-tiny=n
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tun=y

# ---------- 网络优化 ----------
# BBR 拥塞控制，对跨境游戏/大流量比默认 cubic 更稳
CONFIG_PACKAGE_kmod-tcp-bbr=y
# 硬件 NAT 卸载默认不开：会绕过 iptables，和加速器/代理冲突
# CONFIG_PACKAGE_luci-app-sqm 未启用，需要 QoS 时自行打开

# ---------- USB / 轻量 NAS（可注释掉以省空间） ----------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_block-mount=y
# extroot 扩容(把 overlay 搬到 U 盘)需要格式化工具
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_luci-app-diskman=n

# ---------- 运维工具 ----------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_wget-ssl=y

# ---------- 去掉用不上的大件，给 overlay 留空间 ----------
CONFIG_PACKAGE_luci-app-https-dns-proxy=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-nfs=n
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y

# ---------- 内核 / 系统细节 ----------
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_MKLIBS=y
# 关掉没人用的东西，压体积
CONFIG_PACKAGE_ipv6helper=n
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
